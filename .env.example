POSTGRES_DB=sut
POSTGRES_USER=sut
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
APP_PORT=8088
OLLAMA_PORT=11434
OLLAMA_MODEL=deepseek-r1:14b
DEMO_SEED=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Created securely by deploy/init_env.py. This is NOT an OpenAI API key.
APP_ACCESS_TOKEN=CHANGE_ACCESS_TOKEN
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Example model; choose an accessible Responses + Structured Outputs model.
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=128
# Hard limit on attempted calls per UTC day, not a dollar budget.
LLM_DAILY_CALL_LIMIT=100
OLLAMA_URL=http://ollama:11434
